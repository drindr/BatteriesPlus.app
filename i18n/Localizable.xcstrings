    "Register a device to update its battery level, assign an icon, and sync it to the system battery list.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册设备后，可更新电量、设置自定义图标，并同步到系统电池列表。"
