            "value": "右耳"
          }
        }
      }
    },
    "Right-click the desktop, choose Edit Widgets, and search for Batteries++. Small, medium, and large sizes are supported.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键桌面 → 编辑小组件 → 搜索 Batteries++。支持小、中、大三种尺寸。"
          }
        }
      }
    },
    "Runs with /bin/zsh. Output an integer from 0 to 100 or JSON {\"level\":75,\"charging\":false}. Output {\"connected\":false} when disconnected. Updates while the app is running, with a 10-second timeout.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 /bin/zsh 执行。输出整数 0–100，或 JSON {\"level\":75,\"charging\":false}。断开时输出 {\"connected\":false}。主应用运行时定时更新，每次最长 10 秒。"
          }
        }
      }
    },
